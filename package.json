{
  "name": "sql-extension",
  "displayName": "Database Explorer",
  "description": "MySQL, PostgreSQL and Redis database management for VSCode",
  "version": "0.1.0",
  "publisher": "internal",
  "repository": {
    "type": "git",
    "url": "https://github.com/internal/sql-extension"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Database Explorer",
      "properties": {
        "sqlext.ai.model": {
          "type": "string",
          "default": "",
          "description": "Model used by Ask AI in the SQL editor: a Copilot model id, or claude-code:sonnet / claude-code:opus / claude-code:haiku to use your locally logged-in Claude Code subscription. Empty = Claude Code Sonnet when Claude Code is logged in, otherwise the first Copilot model. Pick from the dropdown in the Ask AI bar."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "sqlext.mcp",
        "label": "Database Explorer"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "database-explorer",
          "title": "Database Explorer",
          "icon": "resources/database.svg"
        }
      ]
    },
    "views": {
      "database-explorer": [
        {
          "id": "databaseConnections",
          "name": "Connections"
        }
      ]
    },
    "commands": [
      {
        "command": "sqlext.addConnection",
        "title": "Add Connection",
        "icon": "$(add)",
        "category": "Database"
      },
      {
        "command": "sqlext.removeConnection",
        "title": "Remove Connection",
        "icon": "$(trash)",
        "category": "Database"
      },
      {
        "command": "sqlext.connect",
        "title": "Connect",
        "category": "Database"
      },
      {
        "command": "sqlext.disconnect",
        "title": "Disconnect",
        "category": "Database",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "sqlext.editConnection",
        "title": "Edit Connection",
        "icon": "$(edit)",
        "category": "Database"
      },
      {
        "command": "sqlext.duplicateConnection",
        "title": "Duplicate Connection",
        "category": "Database"
      },
      {
        "command": "sqlext.refreshConnections",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Database"
      },
      {
        "command": "sqlext.cancelConnect",
        "title": "Cancel Connection",
        "category": "Database",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sqlext.duplicateConnection",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "sqlext.addConnection",
          "when": "view == databaseConnections",
          "group": "navigation"
        },
        {
          "command": "sqlext.refreshConnections",
          "when": "view == databaseConnections",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sqlext.cancelConnect",
          "when": "viewItem == connection-connecting",
          "group": "inline"
        },
        {
          "command": "sqlext.cancelConnect",
          "when": "viewItem == connection-connecting",
          "group": "context"
        },
        {
          "command": "sqlext.disconnect",
          "when": "viewItem =~ /^connection-connected/",
          "group": "inline"
        },
        {
          "command": "sqlext.editConnection",
          "when": "viewItem =~ /^connection/",
          "group": "context"
        },
        {
          "command": "sqlext.duplicateConnection",
          "when": "viewItem =~ /^connection/",
          "group": "context"
        },
        {
          "command": "sqlext.removeConnection",
          "when": "viewItem =~ /^connection/",
          "group": "context"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit -p . && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build:webview": "cd webview-ui && npm run build",
    "build": "npm run compile && npm run build:webview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ioredis": "^5.9.3",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.1.0",
    "mysql2": "^3.9.0",
    "pg": "^8.12.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "^1.101.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
